{
    "name": "gulp-has",
    "version": "1.1.0",
    "description": "Optimize code paths using has API feature detection.",
    "keywords": [
        "feature detection",
        "feature-detection",
        "gulpplugin",
        "has",
        "has.js",
        "modernizr",
        "uglify-js"
    ],
    "license": "MIT",
    "author": "Jeff Rose",
    "homepage": "https://github.com/jeffrose/gulp-has",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jeffrose/gulp-has.git"
    },
    "bugs": "https://github.com/jeffrose/gulp-has/issues",
    "type": "commonjs",
    "main": "index.js",
    "exports": {
        ".": {
            "import": "./index.mjs",
            "require": "./index.js",
            "default": "./index.js"
        },
        "./index.js": "./index.js",
        "./index.mjs": "./index.mjs",
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "files": [
        "CHANGELOG.md",
        "index.js",
        "index.mjs"
    ],
    "engines": {
        "node": ">= 22"
    },
    "scripts": {
        "test": "mocha",
        "coverage": "c8 mocha",
        "prepublishOnly": "npm test"
    },
    "dependencies": {
        "plugin-error": "^2.0.1"
    },
    "devDependencies": {
        "c8": "^12.0.0",
        "mocha": "^12.0.3",
        "vinyl": "^3.0.1"
    }
}
